[Desktop Entry]
Type=Application
Name=Refresh D-Bus activation environment
Comment=保证 dbus 激活的服务（ksmserver-logout-greeter 等）能拿到 WAYLAND_DISPLAY，否则点「重启」无反应
Exec=sh -c 'sleep 5; for v in WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QPA_PLATFORM XAUTHORITY XDG_RUNTIME_DIR; do eval "val=\$$v"; [ -n "$val" ] && set -- "$@" "$v=$val"; done; [ $# -gt 0 ] && dbus-update-activation-environment --systemd "$@" 2>/dev/null; true'
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
NoDisplay=true
Terminal=false
