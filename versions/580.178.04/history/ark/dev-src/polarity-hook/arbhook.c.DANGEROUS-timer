/*
 * arbhook.c —— kretprobe 拦截 perfLimits2xArbitrate_30 (_nv050524rm)，
 *              直接篡改 pArbOutput2x->clocks[].curValueToSet
 *
 * ── 为什么 hook 这层而不是 PolarityGet ────────────────────────────
 *
 * PolarityGet 只返回一个布尔，真正写 curValueToSet 的是仲裁函数：
 *
 *     perfLimits2xArbitrate_30(pGpu, pPerf, pLimits2x,
 *                              pLimitMaskExclude, pArbOutput2x, bSetValuesMin)
 *                              rdi   rsi   rdx         rcx          r8      r9
 *
 * ⇒ **pArbOutput2x 是第 5 个参数 (r8)**，在 entry_handler 里存下来，
 *    ret_handler 里就能直接改，不需要找局部变量。
 *
 * ── clocks[] 的内存布局（从 580 反编译读出，待本模块实测确认）────
 *
 *   _nv050524rm 里：
 *     uVar3 = *(u32*)(pArbOutput2x + i*0x24 + 0x38);   // range.maxValue
 *     if (bSetValuesMin) uVar3 = *(u32*)(... + 0x34);  // range.minValue
 *     *(u32*)(pArbOutput2x + i*0x24 + 0x50) = uVar3;   // curValueToSet
 *
 *   _nv014904rm 里逐域比较（确认了基址与步长）：
 *     piVar18 = (int*)(pArbOutput2x + 0x50);   // clocks[0].curValueToSet
 *     piVar18 += 9;                            // +0x24 → clocks[1]
 *
 * ⇒ stride = 0x24，clocks[0] 的 curValueToSet 在 +0x50，
 *   range.min 在 +0x34，range.max 在 +0x38。
 *
 * ── 为什么改这里就能生效 ────────────────────────────────────────
 *
 * 改完 pArbOutput2x 之后，_nv014904rm 会拿它跟前一份做逐域比较：
 *
 *     if (*piVar10 != *piVar18) { bChanged = true; ... }
 *
 * 我们改了值 ⇒ 比较不相等 ⇒ **自动置 bChanged=true** ⇒ 走完整下发路径。
 * 不需要额外"递增 arbSeqId"来绕过缓存 —— 那个缓存是在**进来之前**判断的，
 * 我们改的是**出去之后**的数据，天然不会被缓存吃掉。
 *
 * ── 模式 ────────────────────────────────────────────────────────
 *   mode=0  只观察（dump 结构，不改）
 *   mode=1  把 MCLK 的 curValueToSet 强制改成 target_khz
 *
 * sysfs /sys/kernel/p104_arb/{mode,dump,target_khz,stat,mclk_idx}
 */

#define pr_fmt(fmt) "p104_arb: " fmt

#include <linux/module.h>
#include <linux/kernel.h>
#include <linux/kprobes.h>
#include <linux/sysfs.h>
#include <linux/kobject.h>
#include <linux/jiffies.h>

MODULE_LICENSE("GPL");
MODULE_DESCRIPTION("kretprobe on perfLimits2xArbitrate_30: override MCLK curValueToSet");
MODULE_VERSION("0.1.0");

/* perfLimits2xArbitrate_30 @ 580.178.04, 离线 rva 0x8a2dd0 */
#define TARGET_SYMBOL   "_nv050524rm"

/* clocks[] 布局 —— 待实测确认 */
#define CLK_STRIDE      0x24u
#define CLK_CURVALUE    0x50u   /* clocks[0].curValueToSet */
#define CLK_RANGE_MIN   0x34u
#define CLK_RANGE_MAX   0x38u
#define CLK_MAX_ENTRIES 8u

/* 目标频率：5005 MHz = 5005000 kHz */
static unsigned int target_khz = 5005000;
static int mode = 0;             /* 0=dump only, 1=always override, 2=auto(busy only) */
static int mclk_idx = -1;        /* -1 = 自动探测 */
static unsigned long busy_window_ms = 2000;
static unsigned long busy_until;   /* jiffies，0 = 不忙 */

static void apply_override(void __iomem *arb);
static void gov_fn(struct timer_list *t);

static inline bool is_busy(void)
{
    if (!READ_ONCE(busy_until))
        return false;
    return time_before(jiffies, READ_ONCE(busy_until));
}

static atomic64_t stat_calls = ATOMIC64_INIT(0);
static atomic64_t stat_patched = ATOMIC64_INIT(0);
static atomic64_t stat_dumps = ATOMIC64_INIT(0);

/* 最近一次 dump 的内容，供 sysfs 读 */
#define DUMP_LINES 32
static char dumpbuf[DUMP_LINES * 96];
static DEFINE_MUTEX(dump_lock);
static bool dump_requested;

static struct kretprobe krp;
static struct kobject *kobj;
static struct timer_list gov_timer;
static unsigned long *last_arb;      /* 最近一次的 pArbOutput2x（8 字节对齐存放） */
static unsigned long last_arb_addr;
static unsigned long gov_ms = 200;
static atomic64_t stat_timer_patch = ATOMIC64_INIT(0);

/* 每次调用保存 pArbOutput2x（r8 = 第 5 参数） */
static int entry_handler(struct kretprobe_instance *ri, struct pt_regs *regs)
{
    unsigned long *data = (unsigned long *)ri->data;
    data[0] = regs->r8;          /* pArbOutput2x */
    atomic64_inc(&stat_calls);
    return 0;
}

/* ---- 核心 override（ret_handler 与 timer 共用）---- */
static void apply_override(void __iomem *arb)
{
    u32 *e, *cur, rmin, want;
    bool want_max;

    if (!arb || mclk_idx < 0)
        return;
    e    = (u32 *)((u8 *)arb + (unsigned int)mclk_idx * CLK_STRIDE);
    cur  = (u32 *)((u8 *)e + CLK_CURVALUE);
    rmin = READ_ONCE(*(u32 *)((u8 *)e + CLK_RANGE_MIN));

    if (mode == 1)      want_max = true;
    else if (mode == 2) want_max = is_busy();
    else                return;

    want = want_max ? target_khz : rmin;
    if (want && READ_ONCE(*cur) != want) {
        WRITE_ONCE(*cur, want);
        atomic64_inc(&stat_patched);
    }
}

/* ---- 定时器：仲裁被缓存（calls 很低）时主动维持状态 ---- */
static void gov_fn(struct timer_list *t)
{
    if (mode == 1 || mode == 2) {
        unsigned long a = READ_ONCE(last_arb_addr);
        if (a && mclk_idx >= 0) {
            u32 *e = (u32 *)((u8 *)a + (unsigned int)mclk_idx * CLK_STRIDE);
            u32 *cur = (u32 *)((u8 *)e + CLK_CURVALUE);
            u32 rmin = READ_ONCE(*(u32 *)((u8 *)e + CLK_RANGE_MIN));
            bool want_max = (mode == 1) || (mode == 2 && is_busy());
            u32 want = want_max ? target_khz : rmin;
            if (want && READ_ONCE(*cur) != want) {
                WRITE_ONCE(*cur, want);
                atomic64_inc(&stat_timer_patch);
            }
        }
        mod_timer(&gov_timer, jiffies + msecs_to_jiffies(READ_ONCE(gov_ms)));
    }
}

static int ret_handler(struct kretprobe_instance *ri, struct pt_regs *regs)
{
    unsigned long *data = (unsigned long *)ri->data;
    void __iomem *arb = (void __iomem *)data[0];
    u32 *base;
    unsigned int i;
    char *p;
    int n = 0;

    if (!arb)
        return 0;

    WRITE_ONCE(last_arb_addr, (unsigned long)arb);
    base = (u32 *)arb;

    /* ---- 自动探测 MCLK 索引：range.max 落在 5000~6000 MHz(单位 kHz) ---- */
    if (mclk_idx < 0) {
        for (i = 0; i < CLK_MAX_ENTRIES; i++) {
            u32 *e = (u32 *)((u8 *)base + i * CLK_STRIDE);
            u32 rmin = *(u32 *)((u8 *)e + CLK_RANGE_MIN);
            u32 rmax = *(u32 *)((u8 *)e + CLK_RANGE_MAX);
            /* MCLK: max ≈ 5005000 kHz；GPC: max ≈ 1911000 kHz */
            if (rmax >= 4990000u && rmax <= 5100000u) {
                mclk_idx = (int)i;
                pr_info("自动探测 MCLK: idx=%d range=[%u, %u]\n",
                        i, rmin, rmax);
                break;
            }
        }
    }

    /* ---- dump ---- */
    if (unlikely(dump_requested)) {
        mutex_lock(&dump_lock);
        p = dumpbuf;
        n = scnprintf(p, 96, "pArbOutput2x=%px stride=0x%x\n", arb, CLK_STRIDE);
        p += n;
        for (i = 0; i < CLK_MAX_ENTRIES; i++) {
            u32 *e = (u32 *)((u8 *)base + i * CLK_STRIDE);
            u32 rmin = *(u32 *)((u8 *)e + CLK_RANGE_MIN);
            u32 rmax = *(u32 *)((u8 *)e + CLK_RANGE_MAX);
            u32 cur  = *(u32 *)((u8 *)e + CLK_CURVALUE);
            if (rmin == 0 && rmax == 0 && cur == 0)
                break;   /* 后面全是空的 */
            n = scnprintf(p, 96,
                "clk[%u] @+0x%02x  min=%-8u max=%-8u cur=%-8u%s\n",
                i, i * CLK_STRIDE + CLK_CURVALUE, rmin, rmax, cur,
                ((int)i == mclk_idx) ? "  <-- MCLK" : "");
            p += n;
        }
        *p = 0;
        dump_requested = false;
        mutex_unlock(&dump_lock);
        atomic64_inc(&stat_dumps);
    }

    /* ---- override（逻辑在 apply_override 里）---- */
    apply_override((void __iomem *)base);
    return 0;
}

/* ---------------- sysfs ---------------- */

static ssize_t mode_show(struct kobject *k, struct kobj_attribute *a, char *b)
{ return sysfs_emit(b, "%d\n", mode); }

static ssize_t mode_store(struct kobject *k, struct kobj_attribute *a,
                          const char *b, size_t n)
{
    int v;
    if (kstrtoint(b, 10, &v) || v < 0 || v > 2) return -EINVAL;
    WRITE_ONCE(mode, v);
    pr_info("mode -> %d\n", v);
    return n;
}
static struct kobj_attribute attr_mode = __ATTR(mode, 0644, mode_show, mode_store);

static ssize_t dump_show(struct kobject *k, struct kobj_attribute *a, char *b)
{
    int r;
    mutex_lock(&dump_lock);
    r = sysfs_emit(b, "%s", dumpbuf[0] ? dumpbuf : "(尚未 dump，先 echo 1 > dump)\n");
    mutex_unlock(&dump_lock);
    return r;
}
static ssize_t dump_store(struct kobject *k, struct kobj_attribute *a,
                          const char *b, size_t n)
{
    int v;
    if (kstrtoint(b, 10, &v)) return -EINVAL;
    if (v) dump_requested = true;
    return n;
}
static struct kobj_attribute attr_dump = __ATTR(dump, 0644, dump_show, dump_store);

static ssize_t tgt_show(struct kobject *k, struct kobj_attribute *a, char *b)
{ return sysfs_emit(b, "%u\n", target_khz); }

static ssize_t tgt_store(struct kobject *k, struct kobj_attribute *a,
                         const char *b, size_t n)
{
    unsigned int v;
    if (kstrtouint(b, 10, &v) || v < 100000 || v > 8000000) return -EINVAL;
    WRITE_ONCE(target_khz, v);
    return n;
}
static struct kobj_attribute attr_tgt =
    __ATTR(target_khz, 0644, tgt_show, tgt_store);

static ssize_t idx_show(struct kobject *k, struct kobj_attribute *a, char *b)
{ return sysfs_emit(b, "%d\n", mclk_idx); }
static ssize_t idx_store(struct kobject *k, struct kobj_attribute *a,
                         const char *b, size_t n)
{
    int v;
    if (kstrtoint(b, 10, &v) || v < -1 || v > 15) return -EINVAL;
    WRITE_ONCE(mclk_idx, v);
    return n;
}
static struct kobj_attribute attr_idx =
    __ATTR(mclk_idx, 0644, idx_show, idx_store);

static ssize_t stat_show(struct kobject *k, struct kobj_attribute *a, char *b)
{
    return sysfs_emit(b,
        "symbol     : %s\n"
        "mode       : %d  (0=dump only, 1=always, 2=auto/busy-only)\n"
        "target_khz : %u\n"
        "mclk_idx   : %d  (-1=未探测)\n"
        "stride     : 0x%x\n"
        "cur_offset : 0x%x\n"
        "calls      : %lld\n"
        "patched    : %lld\n"
        "dumps      : %lld\n"
        "busy       : %d\n"
        "busy_ms    : %lu\n"
        "timer_patch: %lld   (定时器主动续期的次数)\n",
        TARGET_SYMBOL, mode, target_khz, mclk_idx,
        CLK_STRIDE, CLK_CURVALUE,
        (long long)atomic64_read(&stat_calls),
        (long long)atomic64_read(&stat_patched),
        (long long)atomic64_read(&stat_dumps),
        is_busy() ? 1 : 0, READ_ONCE(busy_window_ms),
        (long long)atomic64_read(&stat_timer_patch));
}
static struct kobj_attribute attr_stat = __ATTR(stat, 0444, stat_show, NULL);

static ssize_t busy_store(struct kobject *k, struct kobj_attribute *a,
                          const char *b, size_t n)
{
    int v;
    if (kstrtoint(b, 10, &v)) return -EINVAL;
    if (v)
        WRITE_ONCE(busy_until,
                   jiffies + msecs_to_jiffies(READ_ONCE(busy_window_ms)));
    else
        WRITE_ONCE(busy_until, 0);
    return n;
}
static ssize_t busy_show(struct kobject *k, struct kobj_attribute *a, char *b)
{ return sysfs_emit(b, "%d\n", is_busy() ? 1 : 0); }
static struct kobj_attribute attr_busy =
    __ATTR(busy, 0644, busy_show, busy_store);

static ssize_t bw_show(struct kobject *k, struct kobj_attribute *a, char *b)
{ return sysfs_emit(b, "%lu\n", READ_ONCE(busy_window_ms)); }
static ssize_t bw_store(struct kobject *k, struct kobj_attribute *a,
                        const char *b, size_t n)
{
    unsigned long v;
    if (kstrtoul(b, 10, &v) || v > 600000) return -EINVAL;
    WRITE_ONCE(busy_window_ms, v);
    return n;
}
static struct kobj_attribute attr_bw =
    __ATTR(busy_window_ms, 0644, bw_show, bw_store);

static struct attribute *attrs[] = {
    &attr_mode.attr, &attr_dump.attr, &attr_tgt.attr,
    &attr_idx.attr, &attr_stat.attr, &attr_busy.attr, &attr_bw.attr, NULL,
};
static struct attribute_group attr_group = { .attrs = attrs };

/* ---------------- init / exit ---------------- */

static int __init ah_init(void)
{
    int ret;

    memset(&krp, 0, sizeof(krp));
    krp.kp.symbol_name = TARGET_SYMBOL;
    krp.entry_handler  = entry_handler;
    krp.handler        = ret_handler;
    krp.data_size      = sizeof(unsigned long);
    krp.maxactive      = 32;

    ret = register_kretprobe(&krp);
    if (ret) {
        pr_err("register_kretprobe(%s) 失败: %d\n", TARGET_SYMBOL, ret);
        return ret;
    }
    pr_info("已挂上 %s @ %px\n", TARGET_SYMBOL, krp.kp.addr);

    kobj = kobject_create_and_add("p104_arb", kernel_kobj);
    if (!kobj) { unregister_kretprobe(&krp); return -ENOMEM; }
    ret = sysfs_create_group(kobj, &attr_group);
    if (ret) { kobject_put(kobj); unregister_kretprobe(&krp); return ret; }

    timer_setup(&gov_timer, gov_fn, 0);
    gov_timer.expires = jiffies + msecs_to_jiffies(READ_ONCE(gov_ms));
    add_timer(&gov_timer);

    pr_info("就绪。先 echo 1 > /sys/kernel/p104_arb/dump 看结构\n");
    return 0;
}

static void __exit ah_exit(void)
{
    del_timer_sync(&gov_timer);
    WRITE_ONCE(mode, 0);
    sysfs_remove_group(kobj, &attr_group);
    kobject_put(kobj);
    unregister_kretprobe(&krp);
    pr_info("已卸载。calls=%lld patched=%lld\n",
            (long long)atomic64_read(&stat_calls),
            (long long)atomic64_read(&stat_patched));
}

module_init(ah_init);
module_exit(ah_exit);
